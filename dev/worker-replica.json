{
  "ObservedDBConn": [
    "postgres://rotten_observer:rotten_observer@observed-replica-db:5432/observed?sslmode=disable"
  ],
  "ServerURL": "https://rotten-server:8443",
  "PassKeyFile": "/worker-secrets/pass.key",
  "ServerCAFile": "/certs/ca.pem",
  "StateDir": "/state",
  "MaxSnapshotAge": 30,
  "SanityCheck": "select pg_is_in_recovery()",
  "StatusInterval": 10,
  "ObservationInterval": 10,
  "FQDN": "observed-replica",
  "Project": "dev",
  "Environment": "local",
  "Cluster": "compose",
  "Role": "replica",
  "KeepSchemas": false,
  "CursorPattern": "([^\\s]+)[_\\-]cursor_[0-9a-z]+([^\\s]*)",
  "TempTablePattern": "([^\\s]+)_temp_table_[0-9a-z]{6}[0-9a-z]*([^\\s]*)",
  "MinmaxResetSchema": "rotten"
}
