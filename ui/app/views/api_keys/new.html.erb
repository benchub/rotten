<% content_for :title, "New pass key" %>
<div class="api-keys">
  <%= render "shared/breadcrumbs", trail: [["Admin", admin_path], ["Pass keys", api_keys_path]], current: "New pass key" %>
  <div class="page-header">
    <h1>New pass key</h1>
    <p class="lede">The key is shown once, on the next page.</p>
  </div>
  <div class="card form-card">
    <% if @issue.errors.any? %>
      <div class="report-errors alert alert-error" role="alert">
        <ul>
          <% @issue.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%# Turbo is off so the response, which carries the only copy of the secret, renders in place with no redirect. %>
    <%= form_with model: @issue, scope: :api_key, url: api_keys_path, method: :post, class: "stack", data: { turbo: false } do |form| %>
      <div class="field">
        <%= form.label :name, "Name" %>
        <%= form.text_field :name, required: true, maxlength: ApiKeyIssue::NAME_MAX, autocomplete: "off" %>
      </div>
      <div class="field">
        <%= form.label :fqdn, "FQDN" %>
        <%= form.text_field :fqdn, required: true, maxlength: ApiKeyIssue::FQDN_MAX, autocomplete: "off",
              placeholder: "db1.example.com", aria: { describedby: "fqdn-hint" } %>
        <p class="hint" id="fqdn-hint">The worker host this key is pinned to, as the worker reports it.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= form.submit "Create pass key", class: "btn btn-primary" %>
        <%= link_to "Back to pass keys", api_keys_path, class: "btn btn-quiet" %>
      </div>
    <% end %>
  </div>
</div>
