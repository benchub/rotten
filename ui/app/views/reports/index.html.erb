<% content_for :title, @report && @query.submitted? ? "#{@report.title} - Reports" : "Reports" %>
<% ran = @report && @query.submitted? && @query.errors.empty? %>
<% results = (@report && @query.submitted?) || @query.errors.any? || @timeout_seconds %>
<div class="reports">
  <div class="page-header">
    <h1>Reports</h1>
    <p class="lede">Pick a dataset and a report to run on it. Times are UTC.</p>
  </div>

  <%# The status region is outside the form, which is aria-busy while a report runs: assistive tech may hold back announcements inside a busy element. %>
  <div data-controller="report-busy" data-action="pageshow@window->report-busy#reset">
  <p class="sr-only" role="status" data-report-busy-target="status"></p>
  <%= form_with url: reports_path, method: :get, class: "report-form workbench card", data: { turbo: false, controller: "report-chooser",
                            report_busy_target: "form", action: "submit->report-busy#start" } do %>
    <fieldset class="report-dataset">
      <legend>Dataset</legend>
      <%= render "reports/source_fields", query: @query, reports: Report.all %>
      <div class="field report-match">
        <%= label_tag :match, "Match" %>
        <%= text_field_tag :match, @query.match, maxlength: ReportQuery::MAX_MATCH_LENGTH, autocomplete: "off",
                           spellcheck: false, placeholder: "e.g. users|#index", aria: { describedby: "match-hint" } %>
        <p class="hint" id="match-hint">Optional. A case-insensitive Postgres regex on the query text and the contexts (controller#action, job). The time series ignores it. Untagged calls never match by context.</p>
      </div>
    </fieldset>
    <fieldset class="report-chooser">
      <legend>Report</legend>
      <div class="report-choices">
        <% Report.all.each do |report| %>
          <div class="report-choice">
            <%= radio_button_tag :report, report.key, report == @query.report, data: { report_chooser_target: "choice", action: "report-chooser#update" } %>
            <%= label_tag "report_#{report.key}" do %>
              <span class="report-choice-title"><%= report.title %></span>
              <span class="report-choice-description"><%= report.description %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>
    <div class="report-options">
      <%= render "reports/report_fields", query: @query, reports: Report.all %>
      <% if @query.sort_column&.sortable? %>
        <%# The sort applies only to the report it came from: the controller drops these fields on another report, and without JavaScript the server drops the sort. %>
        <%= tag.div data: { report_chooser_target: "field", reports: @query.report.key } do %>
          <%= hidden_field_tag :sort, @query.sort_column.key %>
          <%= hidden_field_tag :dir, @query.direction %>
          <%= hidden_field_tag :sort_report, @query.report.key %>
        <% end %>
      <% end %>
      <div class="form-actions">
        <span class="report-busy-indicator" aria-hidden="true"><span class="spinner"></span>Running report…</span>
        <%= submit_tag "Run report", name: nil, class: "btn btn-primary", data: { report_busy_target: "button" } %>
      </div>
    </div>
  <% end %>
  </div>

  <% if results %>
    <section class="card results" aria-label="Results">
      <div class="results-body">
        <% if @report && @query.submitted? %>
          <h2 class="report-title"><%= @report.title %></h2>
          <p class="report-description mb-3 text-ink-muted"><%= @report.description %></p>
        <% end %>
        <% if ran && !@query.needs_fingerprint? %>
          <%= render "reports/window", query: @query %>
        <% end %>

        <%= render "reports/messages", query: @query, timeout_seconds: @timeout_seconds %>

        <% if ran && @query.ignored_match? %>
          <p class="report-ignored-match alert alert-warning">Match was ignored: the time series is for one fingerprint.</p>
        <% end %>

        <% if ran && @query.needs_fingerprint? %>
          <p class="report-needs-input alert alert-warning">Enter a fingerprint ID, then run the report.</p>
        <% end %>

        <% if @rows %>
          <% if @rows.empty? %>
            <div class="empty-state">
              <p class="empty-state-title">No rows for this source and time range.</p>
              <p>Try a longer time range, another role, or another source.</p>
            </div>
          <% else %>
            <div class="table-wrap">
              <table class="report">
                <thead>
                  <tr>
                    <% @report.columns.each do |column| %>
                      <%= tag.th(column.sortable? ? report_sort_link(@query, column) : column.label,
                                 scope: "col", class: ("numeric" if column.numeric?), data: { column: column.key },
                                 title: (ReportsHelper::CONTEXT_HEADER_TITLE if column.context?),
                                 aria: { sort: report_aria_sort(@query, column) }) %>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% @rows.each do |row| %>
                    <tr>
                      <% @report.columns.each do |column| %>
                        <td data-column="<%= column.key %>" class="<%= 'numeric' if column.numeric? %>"><%= report_cell(@query, column, row[column.key], row) %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
          <%= unparsed_summary(@unparsed) %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
