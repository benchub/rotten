<%# Validation errors and the timeout message shared by the report and fingerprint pages. %>
<% if query.errors.any? %>
  <div class="report-errors alert alert-error" role="alert">
    <p class="alert-title">Fix these and try again:</p>
    <ul>
      <% query.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if timeout_seconds %>
  <div class="report-errors alert alert-error" role="alert">
    <p class="alert-title">Timed out</p>
    <p>
      This report took longer than <%= number_with_precision(timeout_seconds, precision: 3, strip_insignificant_zeros: true) %>
      seconds and was stopped. Try a shorter time range or a narrower source.
    </p>
  </div>
<% end %>

<% if query.errors.none? && query.stale_values.any? %>
  <div class="report-stale alert alert-warning">
    <p class="alert-title">Ignored filters</p>
    <% if query.sources_empty? %>
      <p>No source has these under the other filters. A field has only these values, so no source matches, so the report is empty:</p>
    <% else %>
      <p>No source has these under the other filters, so the report ignores them:</p>
    <% end %>
    <ul>
      <% query.stale_values.each do |field, values| %>
        <% values.each do |value| %>
          <li><%= ReportQuery.human_attribute_name(field) %> <%= value %></li>
        <% end %>
      <% end %>
    </ul>
  </div>
<% end %>
