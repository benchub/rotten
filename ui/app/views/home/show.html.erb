<h1>Rotten</h1>
<% if notice.present? %>
  <p><%= notice %></p>
<% end %>
<p>Signed in as <%= current_user.email %>.</p>
<p><%= link_to "Reports", reports_path %></p>
<% if current_user.admin? %>
  <p><%= link_to "Pass keys", api_keys_path %></p>
<% end %>
<% if Rails.configuration.x.auth_mode == "password" && current_user.password_login? %>
  <p><%= link_to "Change password", edit_password_path %></p>
<% end %>
<%= button_to "Log out", logout_path, method: :delete %>
