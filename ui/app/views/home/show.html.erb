<div class="page-header">
  <h1>Welcome to Rotten</h1>
  <p class="lede">Signed in as <%= current_user.email %>.</p>
</div>
<% if notice.present? %>
  <p class="alert alert-success" role="status"><%= notice %></p>
<% end %>
<ul class="link-cards">
  <li class="card link-card">
    <h2><%= link_to "Run a report", reports_path %></h2>
    <p>Top queries by time or calls, outliers, replica use, and one query's history.</p>
  </li>
  <% if current_user.admin? %>
    <li class="card link-card">
      <h2><%= link_to "Pass keys", api_keys_path %></h2>
      <p>Create and revoke the keys workers use to send stats.</p>
    </li>
    <li class="card link-card">
      <h2><%= link_to "Audit log", audit_logs_path %></h2>
      <p>Who did what in admin, newest first.</p>
    </li>
  <% end %>
</ul>
