{
	"ObservedDBConn": ["host=yourObservedServerGoesHere dbname= user=rotten_observer password=yourPassword sslmode=require"],
	"ServerURL": "https://rotten-server.example.com:8443",
	"PassKeyFile": "/etc/rotten-worker/pass.key",
	"ServerCAFile": "/etc/rotten-worker/server-ca.pem",
	"StateDir": "/var/lib/rotten-worker",
	"MaxSnapshotAge": 900,
	"SanityCheck": "select true",
	"StatusInterval": 60,
	"ObservationInterval": 300,
	"FQDN": "The FQDN of this host, to locate log sources",
	"Project": "Logical project this worker belongs to",
	"Environment": "Logical environment this worker belongs to",
	"Cluster": "Logical cluster this worker belongs to",
	"Role": "Logical role this worker has, usually something like primary or secondary",
	"KeepSchemas": false,
	"CursorPattern": "([^\\s]+)[_\\-]cursor_[0-9a-z]+([^\\s]*)",
	"TempTablePattern": "([^\\s]+)_temp_table_[0-9a-z]{6}[0-9a-z]*([^\\s]*)",
	"MinmaxResetSchema": "rotten"
}
